# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
BOT_TOKEN=your_telegram_bot_token_from_botfather

# Comma-separated list of allowed Telegram user IDs (Leave empty to allow all)
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# ==============================================================================
# Instagram Graph API Configuration
# ==============================================================================
# Instagram Business or Creator Account ID
IG_USER_ID=your_instagram_business_account_id

# Long-lived Page Access Token or System User Token
IG_ACCESS_TOKEN=your_meta_graph_api_access_token

# ==============================================================================
# AI Engine Configuration
# ==============================================================================
# AI Provider: "gemini" (default) or "local_llm" (LM Studio / Ollama / OpenAI API)
AI_PROVIDER=gemini

# Google Gemini API Configuration (when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key

# Local LLM Configuration (when AI_PROVIDER=local_llm)
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=lm-studio

# ==============================================================================
# Media Storage Configuration
# Instagram Graph API requires media to be accessible via a public HTTPS URL.
#
# Choose STORAGE_TYPE:
# - "r2"    : Cloudflare R2 Storage (Recommended: Fast, Free 10GB, Zero egress fees)
# - "s3"    : AWS S3, MinIO, Wasabi, or other S3-compatible storage
# - "local" : Save to local directory & serve via built-in secure server / Cloudflare Tunnel
# ==============================================================================
STORAGE_TYPE=r2

# ------------------------------------------------------------------------------
# OPTION 1: CLOUDFLARE R2 CONFIGURATION (when STORAGE_TYPE=r2)
# ------------------------------------------------------------------------------
# 1. Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token (Admin Read & Write)
# 2. Account ID is found in the right sidebar of R2 Overview
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=instagram-media

# Public domain linked to the R2 bucket:
# - Custom domain: https://media.yourdomain.com (Settings -> Custom Domains in R2 bucket)
# - OR R2 dev domain: https://pub-xxxxxxxxxxxx.r2.dev (Settings -> Public Development Domain)
R2_PUBLIC_DOMAIN=https://media.yourdomain.com

# ------------------------------------------------------------------------------
# OPTION 2: GENERIC S3 / AWS S3 CONFIGURATION (when STORAGE_TYPE=s3)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET_NAME=instagram-media
S3_PUBLIC_DOMAIN=https://media.yourdomain.com

# ------------------------------------------------------------------------------
# OPTION 3: LOCAL SECURE STORAGE CONFIGURATION (when STORAGE_TYPE=local)
# ------------------------------------------------------------------------------
# Directory path inside container (mapped to ./data/media in docker-compose)
LOCAL_STORAGE_DIR=/app/data/media

# Public URL where Instagram API can reach files from this folder.
# Examples:
#   - Cloudflare Tunnel : https://your-tunnel-name.trycloudflare.com
#   - Custom Domain     : https://media.yourdomain.com
#   - Ngrok             : https://abc1234.ngrok-free.app
LOCAL_PUBLIC_BASE_URL=https://media.yourdomain.com

# Built-in secure HTTP server on port 3018 (Protected against traversal, non-whitelisted extensions, indexing)
LOCAL_SERVER_ENABLED=false
LOCAL_SERVER_HOST=0.0.0.0
LOCAL_SERVER_PORT=3018

# ------------------------------------------------------------------------------
# AUTOMATIC MEDIA CLEANUP (TTL) SETTINGS
# Automatically deletes temporary media files after the specified duration.
# ------------------------------------------------------------------------------
MEDIA_CLEANUP_ENABLED=true
# Time-To-Live in minutes for local media files (e.g., 120 = 2 hours)
MEDIA_TTL_MINUTES=120
# How often to check for expired files (in minutes)
MEDIA_CLEANUP_INTERVAL_MINUTES=30

# ==============================================================================
# WhatsApp Chatbot Connector Configuration (whatsapp-web.js)
# IMPORTANT: DO NOT USE YOUR OWN PERSONAL PHONE NUMBER!
# Use a dedicated phone number / SIM, because all mentions and incoming messages
# in your personal or group chats will trigger bot reactions.
# ==============================================================================
# Enable/disable WhatsApp integration
WHATSAPP_ENABLED=true
# WhatsApp REST connector endpoint (in Docker: http://whatsapp-bot:3019, local: http://localhost:3019)
WHATSAPP_CONNECTOR_URL=http://localhost:3019
# Comma-separated allowed WhatsApp phone numbers (e.g. 79991234567,12025550123). Empty = allow all.
WHATSAPP_ALLOWED_NUMBERS=
# Express API port for WhatsApp connector
WHATSAPP_PORT=3019



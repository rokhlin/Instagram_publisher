# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
BOT_TOKEN=your_telegram_bot_token_from_botfather

# Comma-separated list of allowed Telegram user IDs (Leave empty to allow all)
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# ==============================================================================
# Instagram Graph API Configuration
# ==============================================================================
# Instagram Business or Creator Account ID
IG_USER_ID=your_instagram_business_account_id

# Long-lived Page Access Token or System User Token
IG_ACCESS_TOKEN=your_meta_graph_api_access_token

# ==============================================================================
# Google Gemini API Configuration (for AI caption & hashtags generation)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key

# ==============================================================================
# Media Storage Configuration
# Instagram Graph API requires media to be available at a public HTTPS/HTTP URL.
#
# Choose STORAGE_TYPE:
# - "s3"    : Cloudflare R2, AWS S3, MinIO, Supabase Storage
# - "local" : Save to local directory and serve via URL / built-in server
# ==============================================================================
STORAGE_TYPE=local

# ------------------------------------------------------------------------------
# Option 1: LOCAL STORAGE CONFIGURATION (when STORAGE_TYPE=local)
# ------------------------------------------------------------------------------
# Directory path inside container (mapped to ./data/media in docker-compose)
LOCAL_STORAGE_DIR=/app/data/media

# Public URL where Instagram can download files from this folder.
# Examples:
#   - With domain/Nginx/Caddy : https://media.yourdomain.com
#   - With Cloudflare Tunnel  : https://your-tunnel-name.trycloudflare.com
#   - With ngrok              : https://abc1234.ngrok-free.app
LOCAL_PUBLIC_BASE_URL=https://media.yourdomain.com

# Enable built-in HTTP server on port 3018 inside container (true/false)
LOCAL_SERVER_ENABLED=true
LOCAL_SERVER_HOST=0.0.0.0
LOCAL_SERVER_PORT=3018

# ------------------------------------------------------------------------------
# Option 2: S3 / CLOUDFLARE R2 CONFIGURATION (when STORAGE_TYPE=s3 or r2)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET_NAME=instagram-media
# Public base URL where uploaded files are accessible (e.g. https://pub-xxx.r2.dev or custom CDN)
S3_PUBLIC_DOMAIN=https://media.yourdomain.com
